<%
  var hcfg = theme.header || {};
%>
<div class="page-banner <%= hcfg.banner ? 'has-banner' : '' %>"
     <% if (hcfg.banner) { %>style="background-image:url('<%- echo_asset(hcfg.banner) %>')"<% } %>>
  <span class="page-banner-scrim" style="opacity:<%= (hcfg.overlay === undefined) ? 0.72 : Number(hcfg.overlay) %>"></span>
  <div class="page-banner-inner">
    <div class="page-banner-card">
      <h1 class="page-banner-title"><%= page.title %></h1>
      <% if (page.description) { %><p class="page-banner-desc"><%= page.description %></p><% } %>
    </div>
  </div>
</div>

<div class="layout layout-3col">
  <%- partial('_partial/rail-left') %>

  <div class="layout-main">
    <article class="page-single">
      <div class="post-content">
        <%- page.content %>
      </div>
    </article>
  </div>

  <%- partial('_partial/rail-right') %>
</div>
