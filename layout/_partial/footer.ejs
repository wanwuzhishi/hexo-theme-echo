<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <strong><%= config.title %></strong>
      <p><%= config.description %></p>
    </div>

    <div class="footer-links">
      <%
        var menu = theme.menu || {};
      %>
      <% Object.keys(menu).slice(0, 8).forEach(function (name) { %>
        <a href="<%- url_for(menu[name]) %>"><% var fi = echo_nav_icon(name); %><% if (fi) { %><%- echo_icon(fi, 14) %><% } %><%= name %></a>
      <% }); %>
    </div>
  </div>

  <%
    var footerCfg = theme.footer || {};
    var currentYear = date(new Date(), 'YYYY');
    var sinceYear = footerCfg.since ? String(footerCfg.since) : '';
    // 起始年份与当前年份相同时只显示当前年，避免出现「© 2026 - 2026」
    var yearText = sinceYear && sinceYear !== currentYear
      ? sinceYear + ' - ' + currentYear
      : currentYear;
    var themeName = footerCfg.theme_name || 'Echo 主题';
    var themeUrl = footerCfg.theme_url || 'https://github.com/wanwuzhishi/hexo-theme-echo';
  %>
  <div class="footer-bottom">
    <span>© <%= yearText %> <%= config.author || config.title %></span>
    <% if (footerCfg.beian && footerCfg.beian.enable && footerCfg.beian.text) { %>
      <a href="<%= footerCfg.beian.link || '#' %>" target="_blank" rel="noopener"><%= footerCfg.beian.text %></a>
    <% } %>
    <% if (footerCfg.powered) { %>
      <span>由 <a href="https://hexo.io/" target="_blank" rel="noopener">Hexo</a> 与 <a href="<%= themeUrl %>" target="_blank" rel="noopener"><%= themeName %></a> 驱动</span>
    <% } %>
  </div>
</footer>

<button type="button" class="back-to-top" id="back-to-top" aria-label="回到顶部" title="回到顶部">
  <%- echo_icon('chevron', 18) %>
</button>
