<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="<%= echo_color_vars().accent %>">

<%
  var archiveTitle = '';
  if (is_archive()) {
    archiveTitle = '归档';
    if (page.year) archiveTitle += '：' + page.year + ' 年';
    if (page.month) archiveTitle += ' ' + page.month + ' 月';
  }
  var pageSuffix = Number(page.current) > 1 ? '第 ' + page.current + ' 页。' : '';

  var seoTitle = page.title;
  if (is_archive()) seoTitle = archiveTitle;
  if (!seoTitle && is_category() && page.category) seoTitle = '分类：' + page.category;
  if (!seoTitle && is_tag() && page.tag) seoTitle = '标签：' + page.tag;
  if (is_home() && !seoTitle) {
    seoTitle = config.title + (config.subtitle ? ' · ' + config.subtitle : '');
  } else if (seoTitle) {
    seoTitle = seoTitle + ' · ' + config.title;
  } else {
    seoTitle = config.title;
  }
  if (Number(page.current) > 1) {
    seoTitle = seoTitle + ' · 第 ' + page.current + ' 页';
  }

  var seoDescription = page.description;
  if (!seoDescription) {
    if (is_category() && page.category) {
      seoDescription = '「' + page.category + '」分类下的全部文章。' + pageSuffix + config.description;
    } else if (is_tag() && page.tag) {
      seoDescription = '「' + page.tag + '」标签下的全部文章。' + pageSuffix + config.description;
    } else if (is_archive()) {
      seoDescription = archiveTitle + '。' + pageSuffix + config.description;
    } else if (is_home() && Number(page.current) > 1) {
      seoDescription = '万物之时博客第 ' + page.current + ' 页。' + config.description;
    } else if (page.title) {
      seoDescription = page.title + (Number(page.current) > 1 ? ' · 第 ' + page.current + ' 页' : '') + ' · ' + config.description;
    } else {
      seoDescription = config.description;
    }
  }

  var ogTitle = page.title;
  if (is_archive()) ogTitle = archiveTitle;
  if (!ogTitle && is_category() && page.category) ogTitle = '分类：' + page.category;
  if (!ogTitle && is_tag() && page.tag) ogTitle = '标签：' + page.tag;
  if (!ogTitle) ogTitle = config.title;
  var ogCover = page.cover || (page.photos && page.photos.length ? page.photos[0] : '');
  var ogCoverExt = ogCover ? String(ogCover).split('?')[0].split('.').pop().toLowerCase() : '';
  var ogCoverRaster = ['png', 'jpg', 'jpeg', 'webp', 'gif'].indexOf(ogCoverExt) !== -1;
  var postCats = is_post() && page.categories ? page.categories.toArray() : [];
  var postTags = is_post() && page.tags ? page.tags.toArray() : [];
%>
<title><%= seoTitle %></title>

<meta name="description" content="<%= seoDescription %>">
<% if (config.keywords) { %>
<meta name="keywords" content="<%= Array.isArray(config.keywords) ? config.keywords.join(',') : config.keywords %>">
<% } %>
<% if (config.author) { %>
<meta name="author" content="<%= config.author %>">
<% } %>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
<meta property="og:locale" content="zh_CN">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:url" content="<%- full_url_for(page.path || '/') %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:description" content="<%= seoDescription %>">
<% if (ogCover) { %>
<meta property="og:image" content="<%- full_url_for(ogCover) %>">
<meta property="og:image:alt" content="<%= ogTitle %>">
<% } %>

<% if (is_post()) { %>
<meta property="article:published_time" content="<%- page.date.toISOString() %>">
<% if (page.updated) { %>
<meta property="article:modified_time" content="<%- page.updated.toISOString() %>">
<% } %>
<% if (postCats.length) { %>
<meta property="article:section" content="<%= postCats[0].name %>">
<% } %>
<% postTags.forEach(function (tag) { %>
<meta property="article:tag" content="<%= tag.name %>">
<% }); %>
<% } %>

<meta name="twitter:card" content="<%= ogCoverRaster ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= ogTitle %>">
<meta name="twitter:description" content="<%= seoDescription %>">
<% if (ogCover && ogCoverRaster) { %>
<meta name="twitter:image" content="<%- full_url_for(ogCover) %>">
<meta name="twitter:image:alt" content="<%= ogTitle %>">
<% } %>

<link rel="canonical" href="<%- full_url_for(page.path || '/') %>">

<% if (is_post()) { %>
<%
  var ldUrl = full_url_for(page.path || '/');
  var ldCover = ogCover ? full_url_for(ogCover) : '';
  var ld = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    'headline': page.title,
    'description': seoDescription,
    'url': ldUrl,
    'mainEntityOfPage': { '@type': 'WebPage', '@id': ldUrl },
    'datePublished': page.date.toISOString(),
    'dateModified': (page.updated || page.date).toISOString(),
    'author': { '@type': 'Person', 'name': config.author || config.title },
    'publisher': {
      '@type': 'Organization',
      'name': config.title,
      'logo': { '@type': 'ImageObject', 'url': full_url_for(config.favicon || '/favicon.png') }
    },
    'inLanguage': config.language || 'zh-CN',
    'isPartOf': { '@type': 'Blog', 'name': config.title, 'url': full_url_for('/') }
  };
  if (ldCover) ld.image = [ldCover];
  var ldTags = postTags.map(function (t) { return t.name; }).filter(Boolean);
  if (ldTags.length) ld.keywords = ldTags.join(', ');
  var ldCategories = postCats.map(function (c) { return c.name; }).filter(Boolean);
  if (ldCategories.length) ld.articleSection = ldCategories.join(', ');

  var crumbItems = [{ name: '首页', url: full_url_for('/') }];
  if (postCats.length) crumbItems.push({ name: postCats[0].name, url: full_url_for(postCats[0].path) });
  crumbItems.push({ name: page.title, url: ldUrl });
  var breadcrumbLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': crumbItems.map(function (item, index) {
      return { '@type': 'ListItem', 'position': index + 1, 'name': item.name, 'item': item.url };
    })
  };
%>
<script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c') %></script>
<% } %>

<% if (is_home() && !(Number(page.current) > 1)) { %>
<%
  var websiteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': config.title,
    'alternateName': config.subtitle || undefined,
    'url': full_url_for('/'),
    'description': seoDescription,
    'inLanguage': config.language || 'zh-CN',
    'publisher': {
      '@type': 'Organization',
      'name': config.title,
      'logo': { '@type': 'ImageObject', 'url': full_url_for(config.favicon || '/favicon.png') }
    }
  };
%>
<script type="application/ld+json"><%- JSON.stringify(websiteLd).replace(/</g, '\\u003c') %></script>
<% } %>

<link rel="alternate" type="application/atom+xml" href="<%- url_for('/atom.xml') %>" title="<%= config.title %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap">

<link rel="stylesheet" href="<%- url_for('/css/echo.css') %>">
<%
  var railCfg = theme.rail || {};
  var railLeftW = (railCfg.left && railCfg.left.width) || theme.rail_width || '240px';
  var railRightW = (railCfg.right && railCfg.right.width) || theme.rail_width || '240px';
  var layoutMax = theme.layout_width || '1440px';
  var layoutGap = theme.layout_gap || '36px';
  var mainMax = theme.main_width || '820px';
  var mainWide = theme.main_width_wide || '1240px';
  // 配色：由 colors 配置项派生，主色一改全站跟着变
  var colorVars = echo_color_vars();
  var colorCss = Object.keys(colorVars).map(function (k) {
    return '    --' + k + ': ' + colorVars[k] + ';';
  }).join('\n');
%>
<style>
  :root {
    --rail-w-left: <%= railLeftW %>;
    --rail-w-right: <%= railRightW %>;
    --layout-max: <%= layoutMax %>;
    --layout-gap: <%= layoutGap %>;
    --main-max: <%= mainMax %>;
    --main-wide: <%= mainWide %>;
    /* 头部 / 页脚 / 横幅与三栏对齐 */
    --max-width: <%= layoutMax %>;
    --radius: <%= theme.radius || '14px' %>;
<%- colorCss %>
  }
  /* 宽屏自适应（≥1680px）：
     1. 布局上限随视口放宽（94vw，封顶 2040px），先吃掉最外侧的空白；
     2. 中栏不再写死，而是「吃满」剩余空间：总宽 − 左右栏 − 两道栏距 − 容器内边距，
        这样侧栏向外挪多少，中栏就跟着长多少，侧栏与中栏之间始终只留一道栏距；
     3. --main-wide 是封顶值，防止超宽屏把正文拉成一条过长的行。 */
  @media (min-width: 1680px) {
    :root {
      --layout-max: min(94vw, 2040px);
      --max-width: min(94vw, 2040px);
      --layout-gap: clamp(36px, 2.4vw, 72px);
      --main-max: min(var(--main-wide, 1240px),
        calc(var(--layout-max) - var(--rail-w-left) - var(--rail-w-right) - var(--layout-gap) * 2 - 48px));
    }
  }
</style>
<%
  // 站点图标：站点配置 > 主题配置 > 主题内置默认
  var faviconPath = config.favicon || theme.favicon || '/images/favicon.svg';
  var faviconExt = (faviconPath.split('?')[0].split('.').pop() || '').toLowerCase();
  var faviconType = faviconExt === 'svg' ? 'image/svg+xml'
    : (faviconExt === 'jpg' || faviconExt === 'jpeg') ? 'image/jpeg' : 'image/png';
%>
<link rel="icon" href="<%- echo_asset(faviconPath) %>" type="<%= faviconType %>">
<link rel="apple-touch-icon" href="<%- echo_asset(faviconPath) %>">

<script>
  (function () {
    try {
      var scheme = document.documentElement.getAttribute('data-scheme') || 'auto';
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var resolved = scheme === 'auto' ? (prefersDark ? 'dark' : 'light') : scheme;
      document.documentElement.setAttribute('data-theme', resolved);
      var stored = localStorage.getItem('echo-theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    } catch (e) {}
  })();
</script>
