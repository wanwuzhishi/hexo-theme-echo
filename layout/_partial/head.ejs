<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="<%= theme.accent || '#5b8cff' %>">

<title><% if (is_home() && !page.title) { %><%= config.title %> · <%= config.subtitle %><% } else { %><%= page.title ? page.title + ' · ' + config.title : config.title %><% } %></title>

<% if (page.description) { %>
<meta name="description" content="<%= page.description %>">
<% } else if (config.description) { %>
<meta name="description" content="<%= config.description %>">
<% } %>
<% if (config.keywords) { %>
<meta name="keywords" content="<%= Array.isArray(config.keywords) ? config.keywords.join(',') : config.keywords %>">
<% } %>
<% if (config.author) { %>
<meta name="author" content="<%= config.author %>">
<% } %>

<meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
<meta property="og:title" content="<%= page.title ? page.title : config.title %>">
<meta property="og:url" content="<%- full_url_for(page.path || '/') %>">
<meta property="og:site_name" content="<%= config.title %>">
<% if (page.description || config.description) { %>
<meta property="og:description" content="<%= page.description || config.description %>">
<% } %>
<% var ogCover = page.cover || (page.photos && page.photos.length ? page.photos[0] : ''); %>
<% if (ogCover) { %>
<meta property="og:image" content="<%- echo_asset(ogCover) %>">
<% } %>

<% if (is_post()) { %>
<meta property="article:published_time" content="<%- page.date.toISOString() %>">
<% if (page.updated) { %>
<meta property="article:modified_time" content="<%- page.updated.toISOString() %>">
<% } %>
<% } %>

<link rel="canonical" href="<%- full_url_for(page.path || '/') %>">
<link rel="alternate" type="application/atom+xml" href="<%- url_for('/atom.xml') %>" title="<%= config.title %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap">

<link rel="stylesheet" href="<%- url_for('/css/echo.css') %>">
<%
  var railCfg = theme.rail || {};
  var railLeftW = (railCfg.left && railCfg.left.width) || theme.rail_width || '240px';
  var railRightW = (railCfg.right && railCfg.right.width) || theme.rail_width || '240px';
  var layoutMax = theme.layout_width || '1440px';
  var layoutGap = theme.layout_gap || '36px';
  var mainMax = theme.main_width || '820px';
  var mainWide = theme.main_width_wide || '1240px';
%>
<style>
  :root {
    --rail-w-left: <%= railLeftW %>;
    --rail-w-right: <%= railRightW %>;
    --layout-max: <%= layoutMax %>;
    --layout-gap: <%= layoutGap %>;
    --main-max: <%= mainMax %>;
    --main-wide: <%= mainWide %>;
    /* 头部 / 页脚 / 横幅与三栏对齐 */
    --max-width: <%= layoutMax %>;
    --accent: <%= theme.accent || '#5b8cff' %>;
    --radius: <%= theme.radius || '14px' %>;
  }
  /* 宽屏自适应（≥1680px）：
     1. 布局上限随视口放宽（94vw，封顶 2040px），先吃掉最外侧的空白；
     2. 中栏不再写死，而是「吃满」剩余空间：总宽 − 左右栏 − 两道栏距 − 容器内边距，
        这样侧栏向外挪多少，中栏就跟着长多少，侧栏与中栏之间始终只留一道栏距；
     3. --main-wide 是封顶值，防止超宽屏把正文拉成一条过长的行。 */
  @media (min-width: 1680px) {
    :root {
      --layout-max: min(94vw, 2040px);
      --max-width: min(94vw, 2040px);
      --layout-gap: clamp(36px, 2.4vw, 72px);
      --main-max: min(var(--main-wide, 1240px),
        calc(var(--layout-max) - var(--rail-w-left) - var(--rail-w-right) - var(--layout-gap) * 2 - 48px));
    }
  }
</style>
<%
  // 站点图标：站点配置 > 主题配置 > 主题内置默认
  var faviconPath = config.favicon || theme.favicon || '/images/favicon.svg';
  var faviconExt = (faviconPath.split('?')[0].split('.').pop() || '').toLowerCase();
  var faviconType = faviconExt === 'svg' ? 'image/svg+xml'
    : (faviconExt === 'jpg' || faviconExt === 'jpeg') ? 'image/jpeg' : 'image/png';
%>
<link rel="icon" href="<%- echo_asset(faviconPath) %>" type="<%= faviconType %>">
<link rel="apple-touch-icon" href="<%- echo_asset(faviconPath) %>">

<script>
  (function () {
    try {
      var scheme = document.documentElement.getAttribute('data-scheme') || 'auto';
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var resolved = scheme === 'auto' ? (prefersDark ? 'dark' : 'light') : scheme;
      document.documentElement.setAttribute('data-theme', resolved);
      var stored = localStorage.getItem('echo-theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    } catch (e) {}
  })();
</script>
