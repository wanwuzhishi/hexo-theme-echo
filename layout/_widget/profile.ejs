<%
  var profile = theme.sidebar.profile || {};
  if (!profile.enable) return;
%>
<section class="widget widget-profile">
  <div class="profile-head">
    <img class="profile-avatar" src="<%- echo_asset(profile.avatar) %>" alt="<%= profile.name || config.author %>" loading="lazy"
         onerror="this.onerror=null;this.src='<%- url_for('/images/avatar.svg') %>'">
    <div>
      <h3 class="profile-name"><%= profile.name || config.author %></h3>
      <p class="profile-bio"><%= profile.bio || config.description %></p>
    </div>
  </div>
  <% if (profile.social && Object.keys(profile.social).length) { %>
    <div class="profile-social">
      <% Object.keys(profile.social).forEach(function (name) { %>
        <a href="<%- url_for(profile.social[name]) %>" target="_blank" rel="noopener"
           class="social-link" title="<%= name %>">
          <%- echo_icon(name.toLowerCase() === 'rss' ? 'rss' : (name.toLowerCase() === 'github' ? 'github' : 'external'), 16) %>
          <span><%= name %></span>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>
