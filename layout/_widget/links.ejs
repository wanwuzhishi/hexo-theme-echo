<%
  var cfg = theme.sidebar.links || {};
  if (!cfg.enable || !cfg.items || !cfg.items.length) return;
%>
<section class="widget widget-links">
  <h3 class="widget-title"><%- echo_icon('external', 16) %> 友情链接</h3>
  <ul class="link-list">
    <% cfg.items.forEach(function (item) { %>
      <li>
        <a href="<%- item.url %>" target="_blank" rel="noopener">
          <span><%= item.name %></span>
          <%- echo_icon('external', 14) %>
        </a>
      </li>
    <% }); %>
  </ul>
</section>
