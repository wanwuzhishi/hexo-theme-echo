<%
  var cfg = theme.sidebar.recent || {};
  if (!cfg.enable) return;
  var limit = Number(cfg.limit) || 5;
  var posts = site.posts.sort('-date').limit(limit).toArray();
  if (!posts.length) return;
%>
<section class="widget widget-recent">
  <h3 class="widget-title"><%- echo_icon('clock', 16) %> 最新发布</h3>
  <ul class="recent-list">
    <% posts.forEach(function (post) { %>
      <li>
        <a href="<%- url_for(post.path) %>">
          <span class="recent-title"><%= post.title %></span>
          <span class="recent-meta">
            <time><%= echo_date(post.date, 'MM-DD') %></time>
            <% if (post.resource && post.resource.enable) { %>
              <em class="recent-badge"><%= echo_resource_type(post).name %></em>
            <% } %>
          </span>
        </a>
      </li>
    <% }); %>
  </ul>
</section>
